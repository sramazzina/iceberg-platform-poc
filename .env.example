# Lab configuration. Copy this file to .env and fill it in.
# .env is git-ignored. Never commit real values.

# ---- Catalogs -----------------------------------------------------------------
# Catalogs to start, comma-separated, no spaces: nessie, polaris, baseline (Spark catalog rest).
# Empty = no catalog (default).
# Compose reads this variable itself. Run `make up` after a change.
COMPOSE_PROFILES=

# ---- S3 storage --------------------------------------------------------------
# Bucket and region: copy them from the output of aws/setup.sh.
S3_BUCKET=
AWS_REGION=eu-west-1
# Empty on AWS. Other S3-compatible storage: http://<host>:<port>. The RustFS variant sets it.
S3_ENDPOINT=
# false on AWS, true for other S3-compatible storage. The RustFS variant sets it.
S3_PATH_STYLE_ACCESS=false
# Empty on AWS: the containers use the VM instance profile through IMDSv2.
# Required on-premise, where there is no IMDS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- RustFS (on-premise) ------------------------------------------------------
# Uncomment to run the lab on RustFS instead of AWS S3. S3_BUCKET is then a local bucket
# name, AWS_REGION the RustFS region. S3_ENDPOINT, S3_PATH_STYLE_ACCESS, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY and the Polaris role values are not used: the override sets them.
#COMPOSE_FILE=docker-compose.yml:docker-compose.rustfs.yml
# Host directory for the RustFS data. `make up` creates it. `make reset` does not delete it.
RUSTFS_DATA_DIR=./data/rustfs
# Keys (choose your own values; secrets: at least 8 characters).
# Root: used only by rustfs-setup and the web console.
RUSTFS_ROOT_ACCESS_KEY=rustfsadmin
RUSTFS_ROOT_SECRET_KEY=change-me
# User polaris: Polaris calls the RustFS STS with it to vend credentials.
RUSTFS_POLARIS_ACCESS_KEY=polaris
RUSTFS_POLARIS_SECRET_KEY=change-me
# User lab: Spark, Nessie and the rest catalog (nessie/ and rest/; only list on polaris/).
RUSTFS_LAB_ACCESS_KEY=lab
RUSTFS_LAB_SECRET_KEY=change-me

# ---- Polaris credential vending (from the output of aws/setup.sh) ------------
POLARIS_ROLE_ARN=
POLARIS_EXTERNAL_ID=

# ---- Local secrets (choose your own values) ----------------------------------
POSTGRES_PASSWORD=change-me
POLARIS_DB_PASSWORD=change-me
NESSIE_DB_PASSWORD=change-me
# No ", \ or : in the root id and secret (YAML quoting and HTTP basic auth).
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=change-me
JUPYTER_TOKEN=change-me

# ---- Host user ---------------------------------------------------------------
# Output of `id -u` on the VM. The spark container runs with this UID so that
# notebooks saved in scenarios/ stay editable on the host.
LAB_UID=1000

# ---- Pinned versions (sources in VERSIONS.md) --------------------------------
POSTGRES_IMAGE=postgres:18.6
SPARK_BASE_IMAGE=apache/spark:4.1.3-scala2.13-java17-python3-ubuntu
ICEBERG_VERSION=1.11.0
ICEBERG_SPARK_RUNTIME_ARTIFACT=iceberg-spark-runtime-4.1_2.13
ICEBERG_SPARK_RUNTIME_SHA1=f9b1e4a18797c58ae406104ef5c75d1b64a373c5
ICEBERG_AWS_BUNDLE_SHA1=afe5b22dd5bc2d2c0639049b06a92dae2545cac7
AWSCLI_VERSION=2.39.0
POLARIS_IMAGE=apache/polaris:1.8.0
POLARIS_ADMIN_TOOL_IMAGE=apache/polaris-admin-tool:1.8.0
POLARIS_SETUP_IMAGE=alpine/curl:8.22.0
NESSIE_IMAGE=ghcr.io/projectnessie/nessie:0.109.0
# Nessie CLI uber jar (Maven Central) in the spark image. Same version as NESSIE_IMAGE.
NESSIE_CLI_VERSION=0.109.0
NESSIE_CLI_SHA1=05c7b21afc3ee169966e36ff7fae4753ad8da8a3
REST_FIXTURE_IMAGE=apache/iceberg-rest-fixture:1.10.1
RUSTFS_IMAGE=rustfs/rustfs:1.0.4
RUSTFS_RC_IMAGE=rustfs/rc:v0.1.36
